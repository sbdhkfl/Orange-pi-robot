# Copy this file to .env on the Orange Pi. Never commit real passwords or app passwords.
ROBOT_SERIAL_PORT=/dev/ttyS0
ROBOT_BAUD=115200
ROBOT_CAMERA=2
CAPTURE_DIR=captures

# Email notifications (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=
